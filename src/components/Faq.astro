---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="band">
    <div class="wrap">
      <h2>Najczęstsze pytania</h2>
      <div class="faq">
        {items.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
